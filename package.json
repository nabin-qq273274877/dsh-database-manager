{
  "name": "dsh-database-manager",
  "version": "0.1.0",
  "description": "DSH Web GUI 数据库管理面板：侧边栏入口 + 独立面板，统一管理 SQLite / MySQL / Redis（数据源配置、实时连接池、SQL 浏览器、Redis 键浏览器），并提供受审批保护的 agent 工具。 | Database management panel for the DeepSeek Harness Web GUI: a sidebar entry and a dedicated panel managing SQLite / MySQL / Redis (source configuration, live connection pool, a SQL browser, a Redis key browser), plus approval-guarded agent tools.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "数据库管理",
        "en": "Database Manager"
      },
      "summary": {
        "zh-CN": "侧边栏「数据库管理」面板：统一管理 SQLite / MySQL / Redis，并提供受审批保护的 agent 工具",
        "en": "Sidebar Database Manager panel for SQLite / MySQL / Redis with approval-guarded agent tools"
      },
      "category": "database"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:watch": "tsx watch scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "database",
    "sqlite",
    "mysql",
    "redis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabin-qq273274877/dsh-database-manager.git"
  },
  "dependencies": {
    "ioredis": "^5.9.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "esbuild-wasm": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
